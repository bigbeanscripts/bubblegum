local signLocation = workspace.Worlds["The Overworld"].Islands.Twilight.Island.Board.Display
local offset = CFrame.new(0, 2, 0)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local autoSellLoop = nil

-- Auto Sell every X seconds based on slider
AutoSellToggle:OnChanged(function(value)
    if value then
        autoSellLoop = task.spawn(function()
            while AutoSellToggle.Value do
                local interval = SellIntervalSlider.Value

                local character = player.Character or player.CharacterAdded:Wait()
                local root = character:WaitForChild("HumanoidRootPart")

                root.Anchored = true

                -- Step 1: Go to the sign
                character:PivotTo(signLocation:GetPivot())
                task.wait(1)

                -- Step 2: Fire sell bubble event twice
                local args = {
                    [1] = "SellBubble"
                }

                -- Fire the sell event twice
                pcall(function()
                    game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                    task.wait(1)  -- Add a slight delay between the two events
                    game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                end)

                -- Step 3: Wait 3 seconds and then unanchor
                task.wait(2)
                root.Anchored = false

                task.wait(interval)
            end
        end)
    else
        if autoSellLoop then
            task.cancel(autoSellLoop)
            autoSellLoop = nil
        end
    end
end)

-- Sell When Full Toggle
local SellWhenFullToggle = SellSection:AddToggle("SellWhenFull", {
    Title = "Sell Bubbles When Full",
    Description = "Automatically sells bubbles when storage is full",
    Default = false
})

local sellWhenFullLoop = nil

-- Sell When Full check loop
SellWhenFullToggle:OnChanged(function(value)
    if value then
        sellWhenFullLoop = task.spawn(function()
            while SellWhenFullToggle.Value do
                local bubbleData = player:GetAttribute("Bubble")
                local bubbleTable = type(bubbleData) == "string" and HttpService:JSONDecode(bubbleData) or {}
                local equippedGum = bubbleTable.Gum
                local currentAmount = bubbleTable.Amount

                local success, GumModule = pcall(function()
                    return require(ReplicatedStorage.Shared.Data.Gum)
                end)

                if success and GumModule and equippedGum and currentAmount then
                    local gumInfo = GumModule[equippedGum]
                    local gumStorage = gumInfo and gumInfo.Storage

                    if gumStorage and currentAmount >= gumStorage then
                        local character = player.Character or player.CharacterAdded:Wait()
                        local root = character:WaitForChild("HumanoidRootPart")

                        root.Anchored = true

                        -- Step 1: Go to the sign
                        character:PivotTo(signLocation:GetPivot())
                        task.wait(1.5)

                        -- Step 2: Fire sell bubble event twice
                        local args = {
                            [1] = "SellBubble"
                        }

                        -- Fire the sell event twice
                        pcall(function()
                            game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                            task.wait(0.7)  -- Add a slight delay between the two events
                            game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                        end)

                        -- Step 3: Wait 3 seconds and then unanchor
                        task.wait(2)
                        root.Anchored = false
                    end
                end

                task.wait(1)
            end
        end)
    else
        if sellWhenFullLoop then
            task.cancel(sellWhenFullLoop)
            sellWhenFullLoop = nil
        end
    end
end)




