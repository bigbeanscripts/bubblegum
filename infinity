-- Set up toggle functionality
AutoBlowToggle:OnChanged(function(value)
    if value then
        -- Start auto blowing bubbles
        autoBlowLoop = spawn(function()
            while AutoBlowToggle.Value do
                -- Prepare arguments for blowing bubbles
                local args = {
                    [1] = "BlowBubble"
                }
                
