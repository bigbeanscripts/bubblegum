-- Helper function to convert hyphenated rift name to proper egg name for hatching
local function convertRiftNameToEggName(riftName)
    if not riftName then return nil end
    local words = {}
    for word in riftName:gmatch("([^-]+)") do
        table.insert(words, word:sub(1, 1):upper() .. word:sub(2))
    end
    return table.concat(words, " ")
end

