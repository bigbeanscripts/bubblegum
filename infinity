-- Function to get egg luck value from instance
local function getEggLuckValueFromInstance(egg)
    local luckLabel = egg:FindFirstChild("Display") and 
                     egg.Display:FindFirstChild("SurfaceGui") and
                     egg.Display.SurfaceGui:FindFirstChild("Icon") and
                     egg.Display.SurfaceGui.Icon:FindFirstChild("Luck")
    if luckLabel and luckLabel:IsA("TextLabel") then
        return tonumber(string.match(luckLabel.Text, "(%d+)") or "0")
    end
    return 0
end

-- Function to find best egg instance
local function findBestEggInstance(eggName)
    local rifts = workspace:FindFirstChild("Rendered") and workspace.Rendered:FindFirstChild("Rifts")
    if not rifts then return nil end

    local bestEgg = nil
    local highestLuck = -1
    for _, egg in pairs(rifts:GetChildren()) do
        if egg.Name == eggName then
            local luck = getEggLuckValueFromInstance(egg)
            if luck > highestLuck then
                bestEgg = egg
                highestLuck = luck
            end
        end
    end

    if bestEgg then
        local signPos = nil
        pcall(function()
            local sign = bestEgg:FindFirstChild("Sign")
            if sign and sign:FindFirstChild("Sign") and sign.Sign:FindFirstChild("Meshes/sign2_Plane.001") then
                signPos = sign.Sign["Meshes/sign2_Plane.001"].CFrame
            end
        end)

        return {
            name = eggName,
            display = bestEgg:FindFirstChild("Display"),
            signPosition = signPos,
            luck = highestLuck
        }
    end

    return nil
end

