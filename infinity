-- Add Gold/Rift Chest section to the Rift tab
local RiftChestSection = Tabs.Chest:AddSection("Rift Chests")



-- Toggles and loops
local autoGoldChestLoop, goldChestClaimLoop = nil, nil
local autoRiftChestLoop, royalChestClaimLoop = nil, nil
local autoDiceChestLoop, diceChestClaimLoop = nil, nil

-- References for cleanup
local createdBlocks = {}
local origCanCollide = {}

local function setupAutoChest(toggle, chestName, platformName)
    toggle:OnChanged(function(value)
        if value then
            -- Clear previous blocks list
            createdBlocks = {}
            origCanCollide = {}
            
            -- Claim loop
            local chestClaimLoop = task.spawn(function()
                while toggle.Value do
                    local args = { [1] = "UnlockRiftChest", [2] = chestName }
                    pcall(function()
                        game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                    end)
                    task.wait(1)
                end
            end)

            -- Store reference based on chest type
            if chestName == "golden-chest" then
                goldChestClaimLoop = chestClaimLoop
            elseif chestName == "royal-chest" then
                royalChestClaimLoop = chestClaimLoop
            elseif chestName == "dice-chest" then
                diceChestClaimLoop = chestClaimLoop
            end

            -- Teleport + walk loop
            local chestTeleportLoop = task.spawn(function()
                while toggle.Value do
                    local player = game:GetService("Players").LocalPlayer
                    local character = player.Character or player.CharacterAdded:Wait()
                    local humanoid = character:WaitForChild("Humanoid")
                    local rootPart = character:WaitForChild("HumanoidRootPart")

                    -- First check if the specified chest exists
                    local chestExists = workspace.Rendered.Rifts:FindFirstChild(chestName) ~= nil
                    
                    if not chestExists then
                        -- If chest doesn't exist, wait and check again
                        task.wait(15)
                        continue
                    end
                                        
                    -- Now that we know the chest exists, teleport to the appropriate world
                    local remote = game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent
                    local args

                    if chestName == "dice-chest" then
                        -- For Dice Chest, teleport to Minigame Paradise
                        args = {
                            [1] = "Teleport",
                            [2] = "Workspace.Worlds.Minigame Paradise.PortalSpawn"
                        }
                    else
                        -- For Golden/Royal Chest, teleport to Overworld
                        args = {
                            [1] = "Teleport",
                            [2] = "Workspace.Worlds.The Overworld.PortalSpawn"
                        }
                    end

                    remote:FireServer(unpack(args))
                    task.wait(2)

                    -- Locate chest again after teleporting
                    local targetPart
                    local success = pcall(function()
                        targetPart = workspace.Rendered.Rifts[chestName].Chest.Inner
                    end)

                    if not success or not targetPart then
                        task.wait(15)
                        continue
                    end

                    -- Platform under chest (static) - for safety
                    local platform = Instance.new("Part")
                    platform.Size = Vector3.new(10, 1, 10)
                    platform.Position = targetPart.Position - Vector3.new(0, 1, 0)
                    platform.Anchored = true
                    platform.CanCollide = true
                    platform.Transparency = 1
                    platform.Name = platformName
                    platform.Parent = workspace
                    table.insert(createdBlocks, platform)

                    -- Teleport height (5 studs above chest Y level)
                    local teleportHeight = targetPart.Position.Y + 5
                    
                    -- Ground block under player before teleport
                    local spawnBlock = Instance.new("Part")
                    spawnBlock.Size = Vector3.new(6, 1, 6)
                    spawnBlock.Position = Vector3.new(rootPart.Position.X, teleportHeight - 1, rootPart.Position.Z)
                    spawnBlock.Anchored = true
                    spawnBlock.Transparency = 1
                    spawnBlock.CanCollide = true
                    spawnBlock.Name = "SpawnBlock"
                    spawnBlock.Parent = workspace
                    table.insert(createdBlocks, spawnBlock)
                    game:GetService("Debris"):AddItem(spawnBlock, 5)

                    -- Teleport 1 stud above spawn block
                    rootPart.CFrame = CFrame.new(spawnBlock.Position + Vector3.new(0, 1, 0))
                    task.wait(1)

                    -- Enable no-clip by disabling collision for all character parts
                    origCanCollide = {}
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            origCanCollide[part] = part.CanCollide
                            part.CanCollide = false
                        end
                    end

                    -- Target walk position (maintain same Y height but move to chest X,Z)
                    local targetPosition = Vector3.new(targetPart.Position.X + 3, teleportHeight, targetPart.Position.Z)
                    
                    -- Initial movement command
                    humanoid:MoveTo(targetPosition)
                    
                    -- Create continuous platform under player while walking
                    local isWalking = true
                    local lastBlockTime = 0
                    local walkConnection = game:GetService("RunService").Heartbeat:Connect(function()
                        if not toggle.Value then
                            -- Toggle turned off - clean up immediately
                            isWalking = false
                            
                            -- Restore collisions
                            for part, canCollide in pairs(origCanCollide) do
                                if part and part:IsA("BasePart") then
                                    pcall(function()
                                        part.CanCollide = canCollide
                                    end)
                                end
                            end
                            
                            -- Destroy all blocks
                            for _, block in ipairs(createdBlocks) do
                                if block and block.Parent then
                                    block:Destroy()
                                end
                            end
                            createdBlocks = {}
                            return
                        end
                        
                        if not isWalking then
                            return
                        end

                        -- Create air block directly under player if it's time for a new one
                        local currentTime = tick()
                        if currentTime - lastBlockTime >= 0.1 then  -- Create blocks more frequently
                            lastBlockTime = currentTime
                            
                            local airBlock = Instance.new("Part")
                            airBlock.Size = Vector3.new(6, 1, 6)
                            airBlock.Position = Vector3.new(rootPart.Position.X, teleportHeight - 1.5, rootPart.Position.Z)
                            airBlock.Anchored = true
                            airBlock.Transparency = 1
                            airBlock.CanCollide = true
                            airBlock.Name = "AirBlock"
                            airBlock.Parent = workspace
                            table.insert(createdBlocks, airBlock)
                            
                            -- Schedule block for removal after 2 seconds
                            task.delay(2, function()
                                if not toggle.Value then return end -- Skip if toggle is off
                                
                                if airBlock and airBlock.Parent then
                                    for i, block in ipairs(createdBlocks) do
                                        if block == airBlock then
                                            table.remove(createdBlocks, i)
                                            break
                                        end
                                    end
                                    airBlock:Destroy()
                                end
                            end)
                        end
                        
                        -- Keep player at consistent height
                        if rootPart.Position.Y < teleportHeight - 0.5 then
                            rootPart.CFrame = CFrame.new(
                                rootPart.Position.X, 
                                teleportHeight, 
                                rootPart.Position.Z,
                                rootPart.CFrame.LookVector.X, 
                                0, 
                                rootPart.CFrame.LookVector.Z
                            )
                        end
                    end)

                    -- Run for 20 seconds then restart the process
                    task.wait(20)
                    
                    -- Clean up walkConnection
                    if walkConnection then
                        pcall(function() walkConnection:Disconnect() end)
                        walkConnection = nil
                    end
                    
                    -- Restore original collision settings
                    for part, canCollide in pairs(origCanCollide) do
                        if part and part:IsA("BasePart") then
                            pcall(function()
                                part.CanCollide = canCollide
                            end)
                        end
                    end
                    origCanCollide = {}
                    
                    -- Clean up temporary blocks, keep the main platform
                    for i = #createdBlocks, 1, -1 do
                        local block = createdBlocks[i]
                        if block and block.Parent and block.Name ~= platformName then
                            block:Destroy()
                            table.remove(createdBlocks, i)
                        end
                    end
                    
                    -- No waiting between cycles - immediately continue with next loop iteration
                end
            end)

            -- Store reference based on chest type
            if chestName == "golden-chest" then
                autoGoldChestLoop = chestTeleportLoop
            elseif chestName == "royal-chest" then
                autoRiftChestLoop = chestTeleportLoop
            elseif chestName == "dice-chest" then
                autoDiceChestLoop = chestTeleportLoop
            end

        else
            -- Cancel loops based on chest type
            if chestName == "golden-chest" then
                if autoGoldChestLoop then task.cancel(autoGoldChestLoop) autoGoldChestLoop = nil end
                if goldChestClaimLoop then task.cancel(goldChestClaimLoop) goldChestClaimLoop = nil end
            elseif chestName == "royal-chest" then
                if autoRiftChestLoop then task.cancel(autoRiftChestLoop) autoRiftChestLoop = nil end
                if royalChestClaimLoop then task.cancel(royalChestClaimLoop) royalChestClaimLoop = nil end
            elseif chestName == "dice-chest" then
                if autoDiceChestLoop then task.cancel(autoDiceChestLoop) autoDiceChestLoop = nil end
                if diceChestClaimLoop then task.cancel(diceChestClaimLoop) diceChestClaimLoop = nil end
            end

            -- Restore collisions for character parts
            local player = game:GetService("Players").LocalPlayer
            local character = player.Character
            if character then
                for part, canCollide in pairs(origCanCollide) do
                    if part and part:IsA("BasePart") then
                        pcall(function()
                            part.CanCollide = canCollide
                        end)
                    end
                end
            end
            origCanCollide = {}

            -- Clean up all blocks
            for _, block in ipairs(createdBlocks) do
                if block and block.Parent then
                    block:Destroy()
                end
            end
            createdBlocks = {}
            
            -- Also clean up any blocks that might have been missed
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj.Name:find(platformName) or obj.Name == "AirBlock" or obj.Name == "SpawnBlock" or obj.Name == "DestinationBlock" then
                    obj:Destroy()
                end
            end
        end
    end)
end

