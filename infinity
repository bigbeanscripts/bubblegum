-- Function to find a suitable rift
local function findSuitableRift()
    local minimumLuck = tonumber(AutoRiftLuckDropdown.Value) or 5
    local targetEgg = nil

    pcall(function()
        local rifts = workspace:WaitForChild("Rendered"):WaitForChild("Rifts")

        -- First check for Aura eggs
        for _, eggName in pairs(selectedEggs) do
            if string.find(string.lower(eggName), "silly") then
                local eggInfo = findBestEggInstance(eggName)
                if eggInfo and eggInfo.luck >= minimumLuck then
                    targetEgg = eggInfo
                    break
                end
            end
        end

        -- If no Aura eggs, check for any selected egg
        if not targetEgg then
            for _, eggName in pairs(selectedEggs) do
                local eggInfo = findBestEggInstance(eggName)
                if eggInfo and eggInfo.luck >= minimumLuck then
                    targetEgg = eggInfo
                    break
                end
            end
        end
    end)

    return targetEgg
end



