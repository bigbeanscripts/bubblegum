local function toRomanNumerals(level)
    local romanNumerals = { "I", "II", "III", "IV", "V" }
    return romanNumerals[level] or "I"
end

-- Get list of pets
local function getPetsList()
    local petsList, petValues = {}, {}

    local success, LocalData = pcall(function()
        return require(game.ReplicatedStorage.Client.Framework.Services.LocalData)
    end)

    if success and LocalData then
        local data = LocalData:Get()
        for _, pet in pairs(data.Pets or {}) do
            if pet.Id then
                local petName = pet.Name or "Unknown"
                local enchants = pet.Enchants or {}
                local enchantList = {}

                for _, enchant in ipairs(enchants) do
                    local id = enchant.Id or "?"
                    local level = toRomanNumerals(enchant.Level or 1)
                    table.insert(enchantList, id .. " " .. level)
                end

                -- Show "No Enchant" if pet has no enchants
                local enchantStr = (#enchantList > 0) and (" | " .. table.concat(enchantList, ", ")) or " | No Enchant"
                local displayName = petName .. enchantStr .. " | ID: " .. pet.Id

                -- Always add pet to list even if name is duplicate (will have different IDs)
                table.insert(petsList, displayName)
                petValues[displayName] = {
                    id = pet.Id,
                    name = petName,
                    enchants = enchants
                }
            end
        end
    end

    return petsList, petValues
end

