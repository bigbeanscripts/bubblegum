-- Function to check if enchantment is correct
local function isCorrectEnchant(enchant, desired)
    return enchant.Id == desired.Id and enchant.Level == desired.Level
end

-- Auto enchant logic with specific slot reroll and full reroll for both incorrect enchants
local autoRollEnchantLoop
AutoRollEnchantToggle:OnChanged(function(active)
    if active then
        autoRollEnchantLoop = task.spawn(function()
            while AutoRollEnchantToggle.Value do
                local selectedPets, desiredEnchants = {}, {}

                -- Collect selected pets
                for name, selected in pairs(PetSelector.Value or {}) do
                    if selected and petValues[name] then
                        table.insert(selectedPets, petValues[name])
                    end
                end

                -- Collect desired enchantments
                for enchantName, selected in pairs(EnchantSelector.Value or {}) do
                    if selected and enchantMapping[enchantName] then
                        table.insert(desiredEnchants, enchantMapping[enchantName])
                    end
                end

                -- Loop through selected pets
                for _, pet in ipairs(selectedPets) do
                    local enchants = pet.enchants or {}
                    local enchantCount = #enchants

                    -- No enchants? Do full reroll
                    if enchantCount == 0 then
                        local args = { "RerollEnchants", pet.id }
                        pcall(function()
                            game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.Function:InvokeServer(unpack(args))
                        end)
                        task.wait(0.5)
                    else
                        -- Check each enchant slot
                        local allCorrect = true
                        local wrongSlots = {}

                        for slotIndex, petEnchant in ipairs(enchants) do
                            local isCorrect = false
                            for _, desired in ipairs(desiredEnchants) do
                                if isCorrectEnchant(petEnchant, desired) then
                                    isCorrect = true
                                    break
                                end
                            end

                            if not isCorrect then
                                allCorrect = false
                                table.insert(wrongSlots, slotIndex)
                            end
                        end

                        -- If pet has 2 enchant slots and both are incorrect, use full reroll with gems
                        if enchantCount == 2 and #wrongSlots == 2 then
                            local args = { "RerollEnchants", pet.id }
                            pcall(function()
                                game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.Function:InvokeServer(unpack(args))
                            end)
                            task.wait(0.5)
                        -- Special case: If there's only one enchant and UseOrbToggle is on
                        elseif enchantCount == 1 and #wrongSlots == 1 and UseOrbToggle.Value then
                            local args = {
                                "RerollEnchant",
                                pet.id,
                                1  -- First slot
                            }
                            pcall(function()
                                game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                            end)
                            task.wait(0.5)
                        else
                            -- If only some enchants are wrong, reroll individual incorrect slots (orb)
                            if #wrongSlots > 0 and #wrongSlots < enchantCount then
                                for _, slotIndex in ipairs(wrongSlots) do
                                    local args = {
                                        "RerollEnchant",
                                        pet.id,
                                        slotIndex
                                    }
                                    pcall(function()
                                        game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))
                                    end)
                                    task.wait(0.5)
                                end
                            -- If all are wrong (but not handled by the 2-slot case above), do a full reroll (gems)
                            elseif not allCorrect and #wrongSlots == enchantCount and not (enchantCount == 1 and UseOrbToggle.Value) then
                                local args = { "RerollEnchants", pet.id }
                                pcall(function()
                                    game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.Function:InvokeServer(unpack(args))
                                end)
                                task.wait(0.5)
                            end
                        end
                    end

                    task.wait(0.5)  -- Wait between processing pets
                end

                task.wait(0.25)  -- Wait between rounds of checking
            end
        end)
    elseif autoRollEnchantLoop then
        task.cancel(autoRollEnchantLoop)
        autoRollEnchantLoop = nil
    end
end)



