-- Function to create blocks and teleport to destination
local function createPathAndWalkTo(targetPosition, teleportHeight, duration)
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local Debris = game:GetService("Debris")
    
    local player = Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    -- Temporary blocks list for this path
    local pathBlocks = {}
    
    -- Ground block under player before teleport
    local spawnBlock = Instance.new("Part")
    spawnBlock.Size = Vector3.new(6, 1, 6)
    spawnBlock.Position = Vector3.new(rootPart.Position.X, teleportHeight - 1, rootPart.Position.Z)
    spawnBlock.Anchored = true
    spawnBlock.Transparency = 1
    spawnBlock.CanCollide = true
    spawnBlock.Name = "RiftSpawnBlock"
    spawnBlock.Parent = workspace
    table.insert(pathBlocks, spawnBlock)
    Debris:AddItem(spawnBlock, duration + 3)

    -- Teleport 1 stud above spawn block
    rootPart.CFrame = CFrame.new(spawnBlock.Position + Vector3.new(0, 1, 0))
    task.wait(0.5)

    -- Enable no-clip by disabling collision for all character parts
    local origCollisions = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            origCollisions[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    -- Target walk position
    local targetPos = Vector3.new(targetPosition.X, teleportHeight, targetPosition.Z)
    
    -- Initial movement command
    humanoid:MoveTo(targetPos)
    
    -- Create platform at destination
    local destBlock = Instance.new("Part")
    destBlock.Size = Vector3.new(10, 1, 10)
    destBlock.Position = Vector3.new(targetPos.X, teleportHeight - 1, targetPos.Z)
    destBlock.Anchored = true
    destBlock.Transparency = 1
    destBlock.CanCollide = true
    destBlock.Name = "RiftDestBlock"
    destBlock.Parent = workspace
    table.insert(pathBlocks, destBlock)
    
    -- Create continuous platform under player while walking
    local isWalking = true
    local lastBlockTime = 0
    local destinationReached = false
    
    local walkConnection = RunService.Heartbeat:Connect(function()
        if not isWalking then
            return
        end

        -- Check if destination is reached (within 5 studs of target)
        local distanceToTarget = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - 
                                 Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
        
        if distanceToTarget < 5 then
            destinationReached = true
            return -- Stop creating blocks when destination is reached
        end
        
        -- Create air block directly under player if it's time for a new one
        local currentTime = tick()
        if currentTime - lastBlockTime >= 0.1 then  -- Create blocks more frequently
            lastBlockTime = currentTime
            
            local airBlock = Instance.new("Part")
            airBlock.Size = Vector3.new(6, 1, 6)
            airBlock.Position = Vector3.new(rootPart.Position.X, teleportHeight - 1.5, rootPart.Position.Z)
            airBlock.Anchored = true
            airBlock.Transparency = 1
            airBlock.CanCollide = true
            airBlock.Name = "RiftAirBlock"
            airBlock.Parent = workspace
            table.insert(pathBlocks, airBlock)
            
            -- Schedule block for removal after 2 seconds
            task.delay(2, function()
                if airBlock and airBlock.Parent then
                    for i, block in ipairs(pathBlocks) do
                        if block == airBlock then
                            table.remove(pathBlocks, i)
                            break
                        end
                    end
                    airBlock:Destroy()
                end
            end)
        end
        
        -- Keep player at consistent height
        if rootPart.Position.Y < teleportHeight - 0.5 then
            rootPart.CFrame = CFrame.new(
                rootPart.Position.X, 
                teleportHeight, 
                rootPart.Position.Z,
                rootPart.CFrame.LookVector.X, 
                0, 
                rootPart.CFrame.LookVector.Z
            )
        end
    end)

    -- Run for specified duration or until destination reached
    local startTime = os.clock()
    while os.clock() - startTime < duration and not destinationReached do
        task.wait(0.1)
    end
    
    -- Clean up walkConnection
    if walkConnection then
        pcall(function() walkConnection:Disconnect() end)
        walkConnection = nil
    end
    
    -- Restore original collision settings
    for part, canCollide in pairs(origCollisions) do
        if part and part:IsA("BasePart") then
            pcall(function()
                part.CanCollide = canCollide
            end)
        end
    end
    
    -- Clean up temporary blocks
    task.delay(3, function()
        for _, block in ipairs(pathBlocks) do
            if block and block.Parent then
                block:Destroy()
            end
        end
    end)
    
    return destinationReached
end

