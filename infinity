-- Add Auto Buy section to the Main tab
local AutoBuySection = Tabs.Main:AddSection("Auto Buy")

-- Add Buy Best Gum toggle
local BuyBestGumToggle = AutoBuySection:AddToggle("BuyBestGum", {
    Title = "Buy Best Gum",
    Description = "Automatically buys the best gum you can afford",
    Default = false
})

-- Variable to store the buy best gum loop
local buyBestGumLoop = nil

-- Set up toggle functionality
BuyBestGumToggle:OnChanged(function(value)
    if value then
        -- Start checking for better gums
        buyBestGumLoop = spawn(function()
            while BuyBestGumToggle.Value do
                -- Get necessary services
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local Players = game:GetService("Players")
                local HttpService = game:GetService("HttpService")
                local LocalPlayer = Players.LocalPlayer

                -- Try to access the coins label
                local success, coinsLabel = pcall(function()
                    return LocalPlayer.PlayerGui.ScreenGui.HUD.Left.Currency.Coins.Frame.Label
                end)

                -- Get player's current coins
                local playerCoins = 0
                if success and coinsLabel then
                    local coinText = coinsLabel.Text:gsub("[^%d]", "") -- Remove non-numeric characters
                    playerCoins = tonumber(coinText) or 0
                else
                    -- If we can't get coins from UI, try to get from attributes
                    local playerData = LocalPlayer:GetAttribute("PlayerData")
                    if playerData and type(playerData) == "string" then
                        local decodeSuccess, decoded = pcall(function()
                            return HttpService:JSONDecode(playerData)
                        end)
                        if decodeSuccess and decoded.Coins then
                            playerCoins = decoded.Coins
                        end
                    end
                end

                -- Load gum data
                local successGum, GumModule = pcall(function()
                    return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Data"):WaitForChild("Gum"))
                end)

                if successGum then
                    -- Get player's current gum info
                    local bubbleData = LocalPlayer:GetAttribute("Bubble")
                    local bubbleTable = {}
                    if type(bubbleData) == "string" then
                        local decodeSuccess, decoded = pcall(function()
                            return HttpService:JSONDecode(bubbleData)
                        end)
                        if decodeSuccess then
                            bubbleTable = decoded
                        end
                    end

                    local playerGum = bubbleTable.Gum
                    local playerGumStorage = 0
                    if playerGum and GumModule[playerGum] then
                        playerGumStorage = GumModule[playerGum].Storage or 0
                    end

                    -- Get unowned gums with better storage than the current gum
                    local unownedGums = {}

                    for gumName, gumData in pairs(GumModule) do
                        local gumStorage = gumData.Storage or 0
                        local costData = gumData.Cost

                        -- Skip if same gum
                        if gumName == playerGum then continue end

                        -- Must be better than current gum
                        if gumStorage <= playerGumStorage then continue end

                        -- Skip gamepass gums (cost 0 or invalid type)
                        if type(costData) ~= "table" or costData.Type ~= "Currency" or costData.Amount == 0 then continue end

                        -- Add to unowned gums list
                        table.insert(unownedGums, {
                            name = gumName,
                            storage = gumStorage,
                            cost = costData.Amount
                        })
                    end

                    -- Find the next best gum the player can afford
                    local nextBestAffordableGum = nil
                    local nextBestAffordableGumStorage = 0

                    for _, gum in ipairs(unownedGums) do
                        if playerCoins >= gum.cost then
                            if gum.storage > nextBestAffordableGumStorage then
                                nextBestAffordableGum = gum.name
                                nextBestAffordableGumStorage = gum.storage
                            end
                        end
                    end

                    -- Buy the best affordable gum if found
                    if nextBestAffordableGum then
                        local args = {
                            [1] = "GumShopPurchase",
                            [2] = nextBestAffordableGum
                        }

                        pcall(function()
                            -- Fire the remote event to purchase the gum
                            game:GetService("ReplicatedStorage").Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))

                        end)
                    end
                end

                -- Check every 5 seconds
                task.wait(5)
            end
        end)
    else
        -- Stop the buy best gum loop
        if buyBestGumLoop then
            buyBestGumLoop:Cancel()
            buyBestGumLoop = nil
        end
    end
end)


