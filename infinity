-- Add "Unlock All Worlds" button
TeleportSection2:AddButton({
    Title = "Unlock All Overworld Islands",
    Description = "Unlocks all worlds instantly and teleports you to the Zen Island.",
    Callback = function()
        local Players = game:GetService("Players")
        local UserInputService = game:GetService("UserInputService")
        local RunService = game:GetService("RunService")
        local Workspace = game:GetService("Workspace")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")

        local player = Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")

        -- Save original settings to restore later
        local originalGravity = Workspace.Gravity
        local originalJumpPower = humanoid.JumpPower

        -- Apply high jump settings
        Workspace.Gravity = 0
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 1000

        -- Enable infinite jump
        local jumpConnection
        jumpConnection = UserInputService.JumpRequest:Connect(function()
            if humanoid and humanoid.Parent then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)

        -- Monitor Y position and teleport when Y reaches 15995
        local monitor
        monitor = RunService.RenderStepped:Connect(function()
            local position = rootPart.Position

            -- Teleport when Y reaches 15995
            if position.Y >= 15995 and position.Y < 16030 then
                rootPart.CFrame = CFrame.new(position.X, 16030, position.Z)
            end

            -- Reset settings once above Y = 16000 and teleport the player
            if position.Y >= 16000 then
                -- Teleport the player using the FireServer call
                local args = {
                    [1] = "Teleport",
                    [2] = "Workspace.Worlds.The Overworld.Islands.Zen.Island.Portal.Spawn"
                }
                ReplicatedStorage.Shared.Framework.Network.Remote.RemoteEvent:FireServer(unpack(args))

                -- Reset all settings
                Workspace.Gravity = originalGravity
                humanoid.JumpPower = originalJumpPower

                if jumpConnection then
                    jumpConnection:Disconnect()
                end
                if monitor then
                    monitor:Disconnect()
                end
            end
        end)

        -- Simulate jumping every second
        local jumpSimulateConnection
        jumpSimulateConnection = RunService.Heartbeat:Connect(function()
            -- Make the player jump every second
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)

        -- Disconnect the simulated jump after the player crosses Y = 16000
        local stopJumpingConnection
        stopJumpingConnection = RunService.RenderStepped:Connect(function()
            if rootPart.Position.Y >= 16000 then
                if jumpSimulateConnection then
                    jumpSimulateConnection:Disconnect()
                end
                if stopJumpingConnection then
                    stopJumpingConnection:Disconnect()
                end
            end
        end)
    end
})



